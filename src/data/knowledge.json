  "glossary": [
    {
      "term": "Transformer",
      "definition": "基于自注意力机制的神经网络架构"
    },
    {
      "term": "Attention",
      "definition": "注意力机制，计算序列中元素间的相关性"
    },
    {
      "term": "LLM",
      "definition": "大语言模型"
    },
    {
      "term": "RLHF",
      "definition": "基于人类反馈的强化学习"
    },
    {
      "term": "DPO",
      "definition": "直接偏好优化"
    },
    {
      "term": "RAG",
      "definition": "检索增强生成"
    },
    {
      "term": "CoT",
      "definition": "思维链"
    },
    {
      "term": "Agent",
      "definition": "能自主规划和执行任务的 AI 系统"
    },
    {
      "term": "Token",
      "definition": "模型处理文本的最小单位"
    },
    {
      "term": "Embedding",
      "definition": "将文本映射为向量表示"
    },
    {
      "term": "Fine-tuning",
      "definition": "在预训练模型基础上用特定数据继续训练"
    },
    {
      "term": "Prompt",
      "definition": "给模型的输入指令或上下文"
    },
    {
      "term": "MCP",
      "definition": "模型上下文协议，用于工具调用的标准接口"
    },
    {
      "term": "Tool Calling",
      "definition": "模型调用外部工具的能力"
    },
    {
      "term": "MoE",
      "definition": "混合专家模型，通过稀疏激活提升效率"
    },
    {
      "term": "Evals",
      "definition": "AI 应用评测，评估模型性能的方法"
    }
  ]
}
